# =========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================
# IMPORTANT: Copy this file to .env before deployment
# and fill in all values with production credentials

# Server Configuration
PORT=9000
NODE_ENV=production

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataeasy_gh
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_GENERATE_64_CHAR_RANDOM_STRING

# JWT Token Expiry
JWT_EXPIRE=24h

# Paystack Keys - Get LIVE keys from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYSTACK_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Admin Credentials - MUST be strong in production
# Username: minimum 8 characters, alphanumeric
# Password: minimum 16 characters with mixed case, numbers, symbols
ADMIN_USERNAME=CHANGE_THIS_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_THIS_TO_VERY_STRONG_PASSWORD_123!@#

# Frontend URL (for CORS) - Your production domain
FRONTEND_URL=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Daily Admin Wallet Adjustment Limit (in GHC)
DAILY_ADMIN_ADJUSTMENT_LIMIT=10000

# Security Settings
BCRYPT_ROUNDS=12
SESSION_SECRET=CHANGE_THIS_GENERATE_ANOTHER_64_CHAR_RANDOM_STRING
