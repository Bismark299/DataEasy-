# ===========================================
# DATAEASY+ - ENVIRONMENT CONFIGURATION
# ===========================================
# CRITICAL: Copy this file to .env and replace ALL placeholder values
# NEVER commit .env to version control
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=9000
NODE_ENV=development
# Set to 'production' in production!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL Connection (use strong password - 16+ chars, mixed case, numbers, symbols)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataeasy_plus
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_16_CHARS_MIN

# OR use connection string:
# DATABASE_URL=postgresql://user:STRONG_PASSWORD@localhost:5432/dataeasy_plus

# ===========================================
# SECURITY - JWT
# ===========================================
# CRITICAL: Generate a 64-character random secret
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING_GENERATED_BY_CRYPTO

# Token expiry (24h = 24 hours, 7d = 7 days)
JWT_EXPIRE=24h

# ===========================================
# ADMIN CREDENTIALS
# ===========================================
# CRITICAL: Change these before production!
# Username: 8+ characters, alphanumeric
# Password: 16+ characters, mixed case, numbers, symbols
ADMIN_USERNAME=dataeasy_admin
ADMIN_PASSWORD=CHANGE_THIS_To_Strong_P@ssw0rd_16+_chars!

# ===========================================
# PAYSTACK CONFIGURATION
# ===========================================
# Get keys from: https://dashboard.paystack.com/settings/developer
# IMPORTANT: Use TEST keys for development, LIVE keys for production
# Never expose SECRET key in frontend code
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Frontend URL(s) allowed to access API
# In production, set to your actual domain
FRONTEND_URL=https://yourdomain.com

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# MTN ORDER CHECKER - checker.instantdatagh.com
# ===========================================
CHECKER_SITE_URL=https://checker.instantdatagh.com
CHECKER_USERNAME=your_checker_username
CHECKER_PASSWORD=your_checker_password

# ===========================================
# DATA PROVIDER - MCBIS SOLUTION
# ===========================================
# Documentation: https://documenter.getpostman.com/view/11929812/2sB34kDynu
# Get your API token from McbisSolution
MCBIS_API_TOKEN=your_mcbis_api_token_here

# ===========================================
# SECURITY CHECKLIST BEFORE PRODUCTION
# ===========================================
# [ ] Generated new JWT_SECRET (64 chars)
# [ ] Changed ADMIN_PASSWORD (16+ chars, complex)
# [ ] Changed DB_PASSWORD (16+ chars, complex)
# [ ] Updated Paystack to LIVE keys
# [ ] Set MCBIS_API_TOKEN
# [ ] Set NODE_ENV=production
# [ ] Set FRONTEND_URL to production domain
# [ ] Enabled HTTPS on server
# [ ] Reviewed all security settings
