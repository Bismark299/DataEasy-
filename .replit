modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "5000"
NODE_ENV = "development"
JWT_EXPIRE = "24h"
ADMIN_USERNAME = "admin@dataeasy.com"
RATE_LIMIT_WINDOW_MS = "900000"
RATE_LIMIT_MAX_REQUESTS = "1200"
FRONTEND_URL = "https://94d525b7-2de9-45c2-9346-8142e766acf0-00-5caxkjjcldcb.spock.replit.dev"
ALLOWED_ORIGINS = "https://94d525b7-2de9-45c2-9346-8142e766acf0-00-5caxkjjcldcb.spock.replit.dev"
LOOKUP_BASE_URL = "https://4e9af2d5e8c2.hstonline.tech"

[userenv.development]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "backend/server.js"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
